# AuditAI environment template.
# Copy this file to backend/.env (or .env in your API working directory) and fill in local secrets.

# PostgreSQL connection used by SQLAlchemy.
DATABASE_URL=postgresql+psycopg://auditai:auditai@localhost:5432/auditai

# Gemini API key used by the constrained LLM reasoning layer.
# Never commit a real API key. Keep the actual key in backend/.env only.
GEMINI_API_KEY=replace-me

# Gemini model to call for vulnerability explanations.
# You can swap this for another Gemini generateContent-capable model without code changes.
GEMINI_MODEL=gemini-1.5-flash

# Timeout, in seconds, for a single Gemini explanation request.
GEMINI_TIMEOUT_SECONDS=45

# Comma-separated CORS origins for the React dashboard in deployed environments.
# The default app setting already allows http://localhost:5173 for Vite dev.
CORS_ORIGINS=http://localhost:5173
